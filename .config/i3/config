set $mod Mod4
set $alt Mod1

font pango:monospace 8

# Default stuff
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet

exec --no-startup-id $HOME/scripts/launch_polybar.sh

set $up k
set $down j
set $left h
set $right l

# Change focus 
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move focused window
bindsym Mod1+Shift+$left move left
bindsym Mod1+Shift+$down move down
bindsym Mod1+Shift+$up move up
bindsym Mod1+Shift+$right move right

# Audio controls
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status


floating_modifier $mod
tiling_drag modifier titlebar

# Start a terminal
bindsym $mod+Return exec --no-startup-id kitty

# Lock screen
#bindsym $mod+$alt+l exec --no-startup-id betterlockscreen -l

# Start a browser
bindsym $mod+Shift+Return exec --no-startup-id firefox

# Kill focused window
bindsym $mod+Shift+q kill

# start dmenu (a program launcher)
bindsym $mod+space exec --no-startup-id dmenu_run
bindsym $mod+shift+space exec --no-startup-id i3-dmenu-desktop

# Change focus between windows
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Also with arrows
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# split in horizontal orientation
bindsym $alt+h split h

# split in vertical orientation
bindsym $alt+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

set $ws1 " 1 "
set $ws2 " 2 "
set $ws3 " 3 "
set $ws4 " 4 "
set $ws5 " 5 "
set $ws6 " 6 "
set $ws7 " 7 "
set $ws8 " 8 "
set $ws9 " 9 "
set $ws10 " 10 "

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

# resize window (you can also use the mouse for that)
set $mode_resize "Resize"
bindsym $mod+r mode $mode_resize
mode $mode_resize {

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

# ---------------------- LOGOUT MODE ----------------------
# Create Log out, Reboot, Poweroff bindings
set $mode_system "Exit (R)eboot, (P)oweroff, (S)leep (L)ogout"
bindsym $mod+Shift+e mode $mode_system
mode $mode_system {

        bindsym s exec systemctl suspend; mode "default"
        bindsym r exec systemctl reboot; mode "default"
        bindsym p exec systemctl poweroff; mode "default"
		bindsym l exec xfce4-session-logout ; mode "default"
        
        # Back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

# ---------------------- REDSHIFT MODE ----------------------

bindsym $mod+n mode "$mode_redshift"
set $mode_redshift Set colour temperature: (a)uto, (r)eset, (1)500K (2)500K, (3)000K, (4)000K, (5)000K
set $kill_redshift pkill -9 redshift;
mode "$mode_redshift" {
    bindsym a exec --no-startup-id "$kill_redshift redshift -P -t 5000:4000", mode "default"
    bindsym r exec --no-startup-id "$kill_redshift redshift -x", mode "default"
    bindsym 1 exec --no-startup-id "$kill_redshift redshift -P -O 1500", mode "default"
    bindsym 2 exec --no-startup-id "$kill_redshift redshift -P -O 2500", mode "default"
    bindsym 3 exec --no-startup-id "$kill_redshift redshift -P -O 3000", mode "default"
    bindsym 4 exec --no-startup-id "$kill_redshift redshift -P -O 4000", mode "default"
    bindsym 5 exec --no-startup-id "$kill_redshift redshift -P -O 5000", mode "default"
 
    # exit mode: "Enter" or "Escape"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# class                 border  bground text    indicator child_border
client.focused          #F0C674 #F0C674 #FFFFFF #CD5888   #CD5888
client.focused_inactive #333333 #5F676A #FFFFFF #484E50   #5F676A
client.unfocused        #333333 #222222 #888888 #20262E   #20262E
client.urgent           #2F343A #900000 #FFFFFF #900000   #900000
client.placeholder      #000000 #0C0C0C #FFFFFF #000000   #0C0C0C
client.background       #FFFFFF

# Floating windows
for_window [class="Arandr"] floating enable 
for_window [class="pavucontrol"] floating enable 
for_window [class="Blueman-manager"] floating enable 
# for_window [class="1Password"] floating enable 
for_window [class="pokerstars.exe"] floating enable 
# for_window [class="feh"] floating enable 
for_window [title="Slack - Huddle"] floating enable 
for_window [window_role="PictureInPicture"] floating enable border none
for_window [title="Steam Settings"] floating enable 
for_window [class="zoom"] floating enable 
for_window [class="Thunar"] floating enable 
for_window [class="Proton Pass"] floating enable 

# Turn off windows titles
default_border pixel 0
default_floating_border pixel 0

# Toggle tiling / floating
bindsym $mod+Shift+f floating toggle

# Don't show borders when only one window visible on workspace
hide_edge_borders smart

# Move entire workspace to the left output
bindsym $mod+Ctrl+less move workspace to output left

# Set flameshot for screenshots
bindsym Print exec --no-startup-id flameshot gui

# Gaps
gaps inner 0px
gaps outer 0px
smart_gaps on

# App Shortcuts
bindsym $mod+e exec --no-startup-id thunar
bindsym $mod+s exec --no-startup-id xfce4-settings-manager
# bindsym $mod+p exec --no-startup-id 1password
bindsym $mod+p exec --no-startup-id proton-pass

# Dunst shortcuts
bindsym Control+grave exec --no-startup-id exec dunstctl history-pop
bindsym Shift+grave exec --no-startup-id exec dunstctl close-all

# Switch display stuff
bindsym $mod+$alt+m exec --no-startup-id ~/.screenlayout/mobile.sh && $HOME/scripts/set_random_wallpaper & $HOME/scripts/launch_polybar.sh
bindsym $mod+$alt+d exec --no-startup-id ~/.screenlayout/docked.sh && $HOME/scripts/set_random_wallpaper & $HOME/scripts/launch_polybar.sh
bindsym $mod+$alt+h exec --no-startup-id ~/.screenlayout/home.sh && $HOME/scripts/set_random_wallpaper & $HOME/scripts/launch_polybar.sh

# Keyboard layout
bindsym $alt+space exec --no-startup-id ~/scripts/toggle-keyboard

# dmoji
bindsym $mod+period exec --no-startup-id ~/scripts/dmoji

# greenclip popup
bindsym $mod+v exec --no-startup-id rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}'



























